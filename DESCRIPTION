Package: kplotly.r
Title: Concise, Composable Interactive Plots from a Single Call
Version: 0.0.0.9000
Authors@R: c(
    person(
      given = c("Kevin", "Bosirany"),
      family = "Orlando",
      email = "kevinbosirany@gmail.com",
      role = c("aut", "cre"),
      comment = c(ORCID = "0009-0009-2784-3108")
    ),
    person(
      given = "Plotly Technologies Inc.",
